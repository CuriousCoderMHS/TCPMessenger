<Window x:Class="TCPMessenger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TCP Messaging Studio"
        Height="650" Width="760"
        MinHeight="650" MinWidth="760"
        Background="#F4F7FB"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#1677FF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#0F5FC9" />
        <SolidColorBrush x:Key="PanelBrush" Color="White" />
        <SolidColorBrush x:Key="MutedBrush" Color="#607080" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D8E0EA" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#102A43">
            <Grid Margin="24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="52" Height="52">
                    <Border Background="#1677FF" CornerRadius="13" />
                    <Line X1="17" Y1="20" X2="36" Y2="16"
                          Stroke="White" StrokeThickness="3" />
                    <Line X1="17" Y1="20" X2="32" Y2="36"
                          Stroke="White" StrokeThickness="3" />
                    <Ellipse Width="11" Height="11" Fill="White"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Margin="10,14,0,0" />
                    <Ellipse Width="11" Height="11" Fill="White"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,10,10,0" />
                    <Ellipse Width="11" Height="11" Fill="White"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="0,0,15,10" />
                </Grid>

                <StackPanel Grid.Column="1"
                            Margin="13,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="TCP Messaging Studio"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Text="HL7 MLLP and ASTM E1381 communication testing"
                               Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="#B9C9DA" />
                </StackPanel>

                <Border Grid.Column="2"
                        VerticalAlignment="Center"
                        Background="#1D3E5F"
                        CornerRadius="14"
                        Padding="11,5">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8"
                                 Margin="0,0,6,0"
                                 Fill="#6EE7B7" />
                        <TextBlock Text="Ready"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#DDF8EA" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="24,16,24,10"
                Padding="16"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Mode" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" />
                    <ComboBox x:Name="ModeComboBox"
                              Width="140"
                              Margin="0,4,0,0"
                              SelectedIndex="0"
                              SelectionChanged="ModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Host" />
                        <ComboBoxItem Content="Client" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            x:Name="HostSettingsPanel"
                            Margin="16,0,0,0">
                    <TextBlock Text="Host port" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBox x:Name="ListenPortTextBox"
                             Width="105"
                             Margin="0,4,0,0"
                             Text="5000" />
                </StackPanel>

                <WrapPanel Grid.Column="2"
                           x:Name="ClientSettingsPanel"
                           Margin="16,0,0,0">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Server IP / hostname"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="RemoteHostTextBox"
                                 Width="180"
                                 Margin="0,4,0,0"
                                 Text="127.0.0.1" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Server port"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="RemotePortTextBox"
                                 Width="95"
                                 Margin="0,4,0,0"
                                 Text="5000" />
                    </StackPanel>
                </WrapPanel>

                <StackPanel Grid.Column="3" Margin="16,0,8,0">
                    <TextBlock Text="Message Format"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}" />
                    <ComboBox x:Name="FormatComboBox"
                              Width="140"
                              Margin="0,4,0,0"
                              SelectedIndex="1"
                              SelectionChanged="FormatComboBox_SelectionChanged">
                        <ComboBoxItem Content="HL7 (MLLP)" />
                        <ComboBoxItem Content="ASTM E1381" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="4"
                            VerticalAlignment="Bottom">
                    <Button x:Name="ConnectionButton"
                            MinWidth="125"
                            Height="33"
                            Click="ConnectionButton_Click">
                        Start host
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="24,0,24,10"
                Padding="16"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Communication activity"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1C2E40"
                               DockPanel.Dock="Left" />
                    <TextBlock Text="           Live event log"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               DockPanel.Dock="Right" Width="645" Height="15" />
                </DockPanel>

                <TextBox x:Name="MessagesTextBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono"
                         FontSize="11"
                         Background="#F8FAFC"
                         BorderBrush="#DDE6F0"
                         TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="24,0,24,10"
                Padding="14"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="105" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Outgoing message"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1C2E40" />
                    <TextBox x:Name="MessageTextBox"
                             Height="72"
                             Margin="0,7,0,0"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             FontFamily="Cascadia Mono"
                             FontSize="11" />
                </StackPanel>

                <Button Grid.Column="1"
                        Margin="14,25,0,0"
                        Height="42"
                        Background="#EAF1FB"
                        Foreground="#174675"
                        Click="BuildAstmMessage_Click">
                    Build ASTM
                </Button>

                <Button Grid.Column="2"
                        Margin="14,25,0,0"
                        Height="42"
                        Click="SendButton_Click">
                    Send
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Background="#E8EEF5"
                BorderBrush="#D8E0EA"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="24,0">
                <TextBlock Text="TCP Messaging Studio"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="#637487"
                           DockPanel.Dock="Left" />
                <TextBlock Text="Use only with approved test or integration environments."
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="#637487"
                           DockPanel.Dock="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>